# Lab OAuth app used by BOTH:
#   - Keycloak IdP broker → microsoft-login-stand-in
#   - Nango integration credentials (providers.yaml: microsoft-graph-lab)
#
# These are intentional public lab placeholders (also hardcoded in seed.py).
# Not real Entra app credentials.

NANGO_PROVIDER_CONFIG_KEY=microsoft-graph-lab
OAUTH_CLIENT_ID=keycloak-broker
OAUTH_CLIENT_SECRET=keycloak-broker-secret
OAUTH_SCOPES=openid offline_access Mail.Read Mail.Send
