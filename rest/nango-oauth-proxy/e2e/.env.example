# Lab-only defaults (safe to commit). Copy to .env:
#   cp .env.example .env
#
# NANGO_SECRET_KEY is filled by seed.py from the local Nango DB after first boot
# (also mirrored to .nango-secret). See also:
#   .nango-secret.example
#   .nango-encryption-key.example
#   nango/oauth.example.env   ← OAuth client used by Nango + Keycloak IdP broker
#
# Encryption key = base64 of 32 raw bytes (required by Nango).

NANGO_ENCRYPTION_KEY=bG9jYWwtbTM2NS1nYXRld2F5LW5hbmdvLWtleSEhISE=
NANGO_SECRET_KEY=
