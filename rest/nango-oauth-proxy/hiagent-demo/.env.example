# Lab-only defaults (safe to commit). Copy to .env:
#   cp .env.example .env
#
# up.sh also writes KEYCLOAK_HOSTNAME_URL / LOGIN_ISSUER / KEYCLOAK_PUBLIC_URL
# after the Cloudflare tunnel is up. NANGO_SECRET_KEY is filled by seed.py.
# Related examples:
#   .nango-secret.example / .nango-encryption-key.example
#   ../e2e/nango/oauth.example.env  ← OAuth client for Nango + Keycloak IdP

NANGO_ENCRYPTION_KEY=bG9jYWwtbTM2NS1nYXRld2F5LW5hbmdvLWtleSEhISE=
NANGO_SECRET_KEY=
KEYCLOAK_HOSTNAME_URL=http://127.0.0.1:8185
LOGIN_ISSUER=http://127.0.0.1:8581
KEYCLOAK_PUBLIC_URL=http://host.docker.internal:8185
